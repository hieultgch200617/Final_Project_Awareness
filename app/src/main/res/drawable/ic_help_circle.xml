<?xml version="1.0" encoding="utf-8"?>
<!-- "?" in a circle: icon for true/false (question) lessons. Same convention as ic_article:
     white fill + android:tint, so the app can recolour it with imageTint. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:tint="#000000"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- ring -->
    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M12,4 A8,8 0 1,1 12,20 A8,8 0 1,1 12,4 Z"/>

    <!-- question-mark hook -->
    <path
        android:fillColor="#00000000"
        android:pathData="M9.4,9.6 A2.6,2.6 0 1,1 12.9,12 C12.2,12.4 12,12.8 12,13.8"
        android:strokeColor="@android:color/white"
        android:strokeLineCap="round"
        android:strokeWidth="2"/>

    <!-- question-mark dot -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,15.8 A1.2,1.2 0 1,1 12,18.2 A1.2,1.2 0 1,1 12,15.8 Z"/>
</vector>
