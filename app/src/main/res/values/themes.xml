<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme — all screens inherit this -->
    <style name="Theme.Awareness" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary brand color (used by Material components automatically) -->
        <item name="colorPrimary">@color/brand_navy</item>
        <item name="colorPrimaryVariant">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Accent / secondary color -->
        <item name="colorSecondary">@color/brand_blue</item>
        <item name="colorSecondaryVariant">@color/brand_blue_light</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- App background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/white</item>

        <!-- Text field outline color -->
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/brand_blue</item>

    </style>

    <!-- Splash screen theme — full navy background, no action bar -->
    <style name="Theme.Awareness.Splash" parent="Theme.Awareness">
        <item name="android:windowBackground">@color/brand_navy</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
    </style>

</resources>
