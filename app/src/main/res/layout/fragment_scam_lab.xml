<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_navy"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="🔬 Scam Lab"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white"
            app:titleTextColor="@color/white"
            app:titleTextAppearance="@style/ToolbarTitleStyle"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ══════════════════════════════════════════════════ -->
            <!--  STATE: LOADING                                    -->
            <!-- ══════════════════════════════════════════════════ -->

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="80dp"
                android:visibility="visible"/>

            <!-- ══════════════════════════════════════════════════ -->
            <!--  STATE: PLAYING                                    -->
            <!-- ══════════════════════════════════════════════════ -->

            <LinearLayout
                android:id="@+id/layoutGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Instructions Banner -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFF8E7">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👆"
                            android:textSize="20sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tap on any suspicious parts of the message below to flag them as red flags."
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ── Score Progress Bar ──────────────────────── -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <!-- "Red Flags: X / Y" label -->
                    <TextView
                        android:id="@+id/tvFlagCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Red Flags: 0 / 3"
                        android:textColor="@color/error_red"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_semibold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <!-- Hint button (top right) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHint"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Hint"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_medium"
                        app:strokeColor="@color/brand_blue"
                        app:cornerRadius="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <!-- Progress bar showing flags found -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressFlags"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:progress="0"
                        android:max="100"
                        app:trackColor="@color/surface_variant"
                        app:indicatorColor="@color/error_red"
                        app:trackCornerRadius="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tvFlagCount"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ── Scenario Card ───────────────────────────── -->
                <!-- Styled to look like a real SMS/email interface -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardScenario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- SMS/Email Header bar -->
                        <LinearLayout
                            android:id="@+id/layoutSenderHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@color/surface_variant"
                            android:padding="14dp">

                            <!-- Sender avatar circle -->
                            <TextView
                                android:id="@+id/tvSenderAvatar"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:text="V"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:background="@drawable/bg_avatar_circle"
                                android:layout_marginEnd="10dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvSenderName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Vietcombank"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_semibold"/>

                                <TextView
                                    android:id="@+id/tvScenarioType"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="SMS Message"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/poppins_regular"/>

                            </LinearLayout>

                            <!-- Category badge -->
                            <TextView
                                android:id="@+id/tvScenarioCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Phishing"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:fontFamily="@font/poppins_semibold"
                                android:background="@drawable/bg_category_badge"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"/>

                        </LinearLayout>

                        <!-- Message Body — this TextView has tappable spans injected by Java -->
                        <TextView
                            android:id="@+id/tvMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:lineSpacingMultiplier="1.6"
                            android:fontFamily="@font/poppins_regular"
                            android:padding="16dp"
                            android:textIsSelectable="false"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Feedback snackbar area (shown after each tap) -->
                <TextView
                    android:id="@+id/tvTapFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:padding="8dp"
                    android:visibility="invisible"/>

                <!-- Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Submit My Findings"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    app:backgroundTint="@color/brand_navy"
                    app:cornerRadius="12dp"/>

            </LinearLayout>

            <!-- ══════════════════════════════════════════════════ -->
            <!--  STATE: RESULT                                     -->
            <!-- ══════════════════════════════════════════════════ -->

            <LinearLayout
                android:id="@+id/layoutResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Result Header Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/brand_navy">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">

                        <!-- Lottie result animation -->
                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottieResult"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            app:lottie_rawRes="@raw/anim_success"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="false"/>

                        <!-- Result title e.g. "Perfect! You're a Guardian!" -->
                        <TextView
                            android:id="@+id/tvResultTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Perfect!"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:layout_marginTop="8dp"/>

                        <!-- Score: X / Y flags found -->
                        <TextView
                            android:id="@+id/tvResultScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 / 3 Red Flags Found"
                            android:textColor="@color/brand_blue_light"
                            android:textSize="15sp"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginTop="4dp"/>

                        <!-- XP earned -->
                        <TextView
                            android:id="@+id/tvResultXp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+40 XP Earned"
                            android:textColor="@color/xp_gold"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Red Flag Explanations List -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Red Flag Breakdown"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Dynamically populated in Java with one card per flag -->
                <LinearLayout
                    android:id="@+id/layoutFlagBreakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <!-- Play Again Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayAgain"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Play Another Scenario"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    app:backgroundTint="@color/brand_navy"
                    app:cornerRadius="12dp"/>

                <!-- Back to Academy Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackToAcademy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Back to Academy"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_marginBottom="24dp"
                    app:strokeColor="@color/brand_navy"
                    app:cornerRadius="12dp"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
