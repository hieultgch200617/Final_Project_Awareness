<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top AppBar + Tab Switcher -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_navy"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="🛡️ Guardian Tools"
            app:titleTextColor="@color/white"
            app:titleTextAppearance="@style/ToolbarTitleStyle"/>

        <!-- Tab switcher: URL Scanner | Phone Checker -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_navy"
            app:tabTextColor="@color/brand_blue_light"
            app:tabSelectedTextColor="@color/white"
            app:tabIndicatorColor="@color/white"
            app:tabIndicatorHeight="3dp"
            app:tabTextAppearance="@style/TabTextStyle">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔗  URL Scanner"/>

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞  Phone Checker"/>

        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ══════════════════════════════════════════════════ -->
            <!--  PANEL 0 — URL SCANNER                            -->
            <!-- ══════════════════════════════════════════════════ -->

            <LinearLayout
                android:id="@+id/panelUrlScanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Info card explaining what this tool does -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_variant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔍"
                            android:textSize="22sp"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Paste any link to check if it is safe before you open it. Powered by Google Safe Browsing."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- URL Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUrl"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Paste URL here (e.g. http://suspicious.tk)"
                    app:startIconDrawable="@drawable/ic_link"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:imeOptions="actionDone"
                        android:maxLines="2"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Scan Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanUrl"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Scan URL"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_marginTop="12dp"
                    app:backgroundTint="@color/brand_navy"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_shield"
                    app:iconGravity="textStart"/>

                <!-- Loading bar (shown while API call is in progress) -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/brand_blue"
                    app:trackColor="@color/surface_variant"/>

                <!-- ── URL Result Card ──────────────────────── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardUrlResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Rating row: icon + big rating label -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:id="@+id/imgUrlRatingIcon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_check_circle"
                                android:contentDescription="Rating icon"
                                android:layout_marginEnd="12dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvUrlRatingLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="SAFE"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="@color/guardian_green"/>

                                <TextView
                                    android:id="@+id/tvUrlThreatType"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="No threats detected"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"
                                    android:fontFamily="@font/poppins_regular"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginBottom="12dp"/>

                        <!-- Scanned URL label -->
                        <TextView
                            android:id="@+id/tvScannedUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular"
                            android:maxLines="2"
                            android:ellipsize="end"/>

                        <!-- Advice message -->
                        <TextView
                            android:id="@+id/tvUrlAdvice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ══════════════════════════════════════════════════ -->
            <!--  PANEL 1 — PHONE CHECKER                          -->
            <!-- ══════════════════════════════════════════════════ -->

            <LinearLayout
                android:id="@+id/panelPhoneChecker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Info card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_variant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📡"
                            android:textSize="22sp"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Check if a phone number is a VoIP line, has a fraud history, or belongs to a known carrier. Powered by Telesign."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Phone Number Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPhone"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter phone number (e.g. 0912 345 678)"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:imeOptions="actionDone"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Check Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckPhone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Check Number"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_marginTop="12dp"
                    app:backgroundTint="@color/brand_navy"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_search"
                    app:iconGravity="textStart"/>

                <!-- Loading bar -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/brand_blue"
                    app:trackColor="@color/surface_variant"/>

                <!-- ── Phone Result Card ─────────────────────── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPhoneResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Rating row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <ImageView
                                android:id="@+id/imgPhoneRatingIcon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_check_circle"
                                android:contentDescription="Phone rating icon"
                                android:layout_marginEnd="12dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvPhoneRatingLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="SAFE"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="@color/guardian_green"/>

                                <TextView
                                    android:id="@+id/tvPhoneRiskScore"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Risk Score: 0 / 1000"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"
                                    android:fontFamily="@font/poppins_regular"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginBottom="12dp"/>

                        <!-- Detail rows: Carrier, Type, VoIP, Country -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Carrier -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:layout_width="120dp"
                                    android:layout_height="wrap_content"
                                    android:text="Carrier"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular"/>

                                <TextView
                                    android:id="@+id/tvCarrier"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="—"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_semibold"/>

                            </LinearLayout>

                            <!-- Line Type -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:layout_width="120dp"
                                    android:layout_height="wrap_content"
                                    android:text="Line Type"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular"/>

                                <TextView
                                    android:id="@+id/tvLineType"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="—"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_semibold"/>

                            </LinearLayout>

                            <!-- VoIP Status -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:layout_width="120dp"
                                    android:layout_height="wrap_content"
                                    android:text="VoIP"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular"/>

                                <TextView
                                    android:id="@+id/tvVoipStatus"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="—"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_semibold"/>

                            </LinearLayout>

                            <!-- Country -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="120dp"
                                    android:layout_height="wrap_content"
                                    android:text="Country Code"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular"/>

                                <TextView
                                    android:id="@+id/tvCountryCode"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="—"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_semibold"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Advice message -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardPhoneAdvice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/surface_variant">

                            <TextView
                                android:id="@+id/tvPhoneAdvice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"
                                android:padding="12dp"/>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
