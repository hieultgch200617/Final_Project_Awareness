<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Lesson Thumbnail Image -->
        <ImageView
            android:id="@+id/imgThumbnail"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:contentDescription="Lesson thumbnail"
            android:background="@color/surface_variant"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Category Badge (e.g. "Phishing") overlaid on thumbnail -->
        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phishing"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_semibold"
            android:background="@drawable/bg_category_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_margin="10dp"
            app:layout_constraintTop_toTopOf="@id/imgThumbnail"
            app:layout_constraintStart_toStartOf="@id/imgThumbnail"/>

        <!-- Lesson Type Icon (text/image/video) -->
        <ImageView
            android:id="@+id/imgType"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_article"
            android:contentDescription="Lesson type"
            android:layout_margin="10dp"
            app:layout_constraintTop_toTopOf="@id/imgThumbnail"
            app:layout_constraintEnd_toEndOf="@id/imgThumbnail"/>

        <!-- Lesson Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="How Phishing Emails Work"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/imgThumbnail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- XP Reward Badge + Start Button row -->
        <TextView
            android:id="@+id/tvXpReward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ +10 XP"
            android:textColor="@color/xp_gold"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Arrow icon — signals the card is tappable -->
        <ImageView
            android:id="@+id/imgArrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="Open lesson"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgThumbnail"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
