<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp">

    <!-- Lottie animation (star burst / confetti) -->
    <!-- Lottie plays a JSON animation file — download a free "success"
         animation from lottiefiles.com and save it as:
         app/src/main/res/raw/anim_success.json -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieAnim"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:lottie_rawRes="@raw/anim_success"
        app:lottie_autoPlay="true"
        app:lottie_loop="false"/>

    <!-- "Lesson Complete!" heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lesson Complete! 🎉"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_bold"
        android:layout_marginTop="8dp"/>

    <!-- XP earned label — filled in Java -->
    <TextView
        android:id="@+id/tvXpEarned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+10 XP earned"
        android:textColor="@color/xp_gold"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_semibold"
        android:layout_marginTop="4dp"/>

    <!-- Motivational message -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You're one step closer to becoming a Guardian!"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:layout_marginTop="8dp"/>

    <!-- New Total XP -->
    <TextView
        android:id="@+id/tvNewTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total XP: 0"
        android:textColor="@color/brand_navy"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginTop="4dp"/>

    <!-- Continue Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Continue"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_semibold"
        android:layout_marginTop="20dp"
        app:backgroundTint="@color/brand_navy"
        app:cornerRadius="12dp"/>

</LinearLayout>
